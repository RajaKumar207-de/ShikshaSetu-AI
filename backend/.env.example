# ---- Required ----
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# At least 32 random characters in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Environment ----
# Set to "production" when deployed
NODE_ENV=development
# Comma-separated frontend origins allowed by CORS (REQUIRED in production)
CORS_ORIGINS=http://localhost:5173
# Set to "true" when running behind a reverse proxy / load balancer
TRUST_PROXY=false

# ---- External services ----
GEMINI_API_KEY=
SARVAM_API_KEY=

# ---- Browser push (generate with: npx web-push generate-vapid-keys) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
